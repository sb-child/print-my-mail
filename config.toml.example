# print-my-mail 本地配置

[server]
# gRPC 打印服务器地址
target = "127.0.0.1:54321"
# 轮询间隔（秒）
poll_interval = 60
# GitHub 初始轮询间隔（秒）；实际不会低于 poll_interval，
# 也不会低于 GitHub 返回的 X-Poll-Interval
github_poll_interval = 60
# 等待打印任务完成的最长时间（秒）
print_timeout = 120
# 打印失败后的最大重试次数
print_max_retries = 3
# 打印失败重试的初始退避和最大退避（秒）
print_retry_base_delay = 5
print_retry_max_delay = 300
# IMAP 连接和操作超时（秒）
imap_timeout = 30
# 只打印启动前多少秒以内到达的邮件；更早的未读邮件跳过
mail_max_age = 60
# 永久失败通知的死信文件
dead_letter_file = "dead-letter.jsonl"
# 是否抓取 GitHub 通知正文和最新评论
github_fetch_content = true

# 监听一个IMAP邮箱
[[mail]]
# Gmail 去 https://myaccount.google.com/apppasswords 创建
user = "your_email@gmail.com"
pass = "your_app_password"
# host = "imap.gmail.com"
# port = 993
# 可选，默认只监听 INBOX。用 `uv run print-my-mail folders` 查看真实名称
# Gmail 的垃圾邮件文件夹可能是 [Gmail]/&V4NXPpCuTvY- 这类编码
# folders = ["INBOX"]

# 监听一个GitHub账户
[[github]]
# https://github.com/settings/tokens/new，选 notifications, repo
pat = "xxxx"

# 可选：用 OpenAI 兼容接口生成短摘要
# 启用后邮件正文会替换成摘要，GitHub 通知会带上每条摘要
[ai]
enabled = false
# 可以写 base URL，也可以直接写完整的 /chat/completions 地址
base_url = "https://api.openai.com/v1"
# Bearer token；本地服务不需要鉴权时可以留空
token = ""
model = "gpt-4o-mini"
# 单次请求超时（秒）
timeout = 30
# 回答最多多少个字符
max_chars = 100
# 发送给模型的正文最多多少个字符
max_input_chars = 4000
# 拼接进提示词的问题
question = "用不超过 100 字总结内容，并说明是否需要我处理。"
# 发送 response_format = { type = "json_object" }，要求模型返回 {"summary": "..."}
# DeepSeek / OpenAI 支持；不支持 response_format 的本地服务可以设为 false
json_mode = true
