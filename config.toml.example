# print-my-mail 本地配置

[server]
# gRPC 打印服务器地址
target = "127.0.0.1:54321"
# 轮询间隔（秒）
poll_interval = 60
# 等待打印任务完成的最长时间（秒）
print_timeout = 120
# IMAP 连接和操作超时（秒）
imap_timeout = 30
# 永久失败通知的死信文件
dead_letter_file = "dead-letter.jsonl"

# 监听一个IMAP邮箱
[[mail]]
# Gmail 去 https://myaccount.google.com/apppasswords 创建
user = "your_email@gmail.com"
pass = "your_app_password"
# host = "imap.gmail.com"
# port = 993
# 可选，默认只监听 INBOX。Gmail 的垃圾邮件文件夹通常是 "[Gmail]/Spam"
# folders = ["INBOX", "[Gmail]/Spam"]

# 监听一个GitHub账户
[[github]]
# https://github.com/settings/tokens/new，选 notifications, repo
pat = "xxxx"
